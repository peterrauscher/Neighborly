{
  "name": "neighborly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.0.18",
    "@phosphor-icons/react": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "sharp": "^0.33.5",
    "zod": "^3.25.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch server/app.ts",
    "dev:client": "vite --port 5173 --strictPort",
    "build": "vite build",
    "start": "bun server/app.ts",
    "check": "tsc -p tsconfig.json && biome check src server vite.config.ts",
    "lint": "biome lint src server vite.config.ts",
    "format": "biome format --write src server vite.config.ts",
    "format:check": "biome format src server vite.config.ts",
    "test": "bun test",
    "db:check": "bun server/database-cli.ts check",
    "db:backup": "bun server/database-cli.ts backup",
    "db:restore": "bun server/database-cli.ts restore"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.19"
  }
}
